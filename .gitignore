# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# 本机构建中间产物，勿入仓库
/android/.gradle/
/android/local.properties
/android/app/src/main/res/values/*.xml.bak

# 本地下载的 APK 成品（走 Releases 分发，不入代码库）
/dist/

# 签名私钥绝不入仓库：CI 构建时从 GitHub Secrets 现场还原
/android/key.properties
*.jks
*.keystore

# 本机 UI 自查截图（D:/Dev/shot.mjs 生成，看一眼就扔）
/shots/
